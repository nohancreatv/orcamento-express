APP_ENV=production
APP_URL=https://orcamento-express-facil.netlify.app
# Generate a random value: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=orcamento_express
DB_USER=orcamento_app
DB_PASSWORD=
# CA certificate for an external MySQL server, if required by the host.
DB_SSL_CA=
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="Orçamento Express"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Use the supported Graph version shown in your Meta app dashboard.
FACEBOOK_GRAPH_VERSION=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
